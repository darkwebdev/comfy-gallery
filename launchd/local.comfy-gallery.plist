<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>local.comfy-gallery</string>
	<key>ProgramArguments</key><array><string>/bin/zsh</string><string>/path/to/comfy-gallery/run.sh</string></array>
	<key>WorkingDirectory</key><string>/path/to/comfy-gallery</string>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ThrottleInterval</key><integer>30</integer>
	<key>StandardOutPath</key><string>/path/to/comfy-gallery/launchd.log</string>
	<key>StandardErrorPath</key><string>/path/to/comfy-gallery/launchd.log</string>
</dict>
</plist>
